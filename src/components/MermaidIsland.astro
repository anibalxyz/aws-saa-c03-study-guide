---
// MermaidIsland: lazy Mermaid renderer with a fullscreen viewer.
//
// Mounted once per page (via the Footer override). The inline script below
// exits immediately when the page holds no mermaid fences, so the heavy
// mermaid runtime is never fetched on non-diagram pages. On diagrams pages
// each block renders to SVG when it scrolls near the viewport, and a reader
// can open it fullscreen for pan / pinch / wheel-zoom inspection.
//
// Failure policy is warn-only by construction: everything happens
// client-side, so a malformed block can never fail the build — it keeps its
// source text visible plus a short notice, and logs a console warning.
// No UI framework, no eager work, no network beyond the bundled chunk.
---

<dialog class="mermaid-modal" data-mermaid-modal aria-label="Diagram viewer">
  <div class="mermaid-modal-bar">
    <span class="mermaid-modal-hint">Drag to pan · scroll or pinch to zoom</span>
    <div class="mermaid-modal-actions">
      <button type="button" data-mermaid-zoom-in aria-label="Zoom in">+</button>
      <button type="button" data-mermaid-zoom-out aria-label="Zoom out">−</button>
      <button type="button" data-mermaid-zoom-reset>Reset</button>
      <button type="button" data-mermaid-close>Close</button>
    </div>
  </div>
  <div class="mermaid-modal-stage" data-mermaid-stage>
    <div class="mermaid-modal-canvas" data-mermaid-canvas></div>
  </div>
</dialog>

<script>
  const SELECTOR = 'pre[data-language="mermaid"]';

  const blocks = [...document.querySelectorAll(SELECTOR)];
  // No diagrams on this page — skip the runtime entirely.
  if (blocks.length > 0) void init(blocks);

  async function init(targets) {
    let mermaid;
    try {
      ({ default: mermaid } = await import('mermaid'));
    } catch (err) {
      console.warn('[mermaid] runtime failed to load; showing source.', err);
      return;
    }
    const dark = document.documentElement.dataset.theme === 'dark';
    mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default' });

    const render = async (pre) => {
      if (pre.dataset.mermaidDone) return;
      pre.dataset.mermaidDone = 'true';
      const code = pre.querySelector('code');
      const source = (code?.innerText ?? pre.textContent ?? '').trim();
      if (!source) return;
      try {
        const id = `mmd-${Math.random().toString(36).slice(2)}`;
        const { svg } = await mermaid.render(id, source);
        const figure = document.createElement('div');
        figure.className = 'mermaid-figure';
        figure.innerHTML = svg;
        figure.querySelector('svg')?.setAttribute('role', 'img');
        const open = document.createElement('button');
        open.type = 'button';
        open.className = 'mermaid-open';
        open.textContent = 'Open fullscreen';
        open.addEventListener('click', () => openModal(svg));
        pre.replaceChildren(figure, open);
      } catch (err) {
        // Warn-only: keep the source readable, never break the page.
        console.warn('[mermaid] skipping malformed diagram block.', err);
        const note = document.createElement('p');
        note.className = 'mermaid-warn';
        note.textContent =
          'This diagram could not be rendered, showing its source instead.';
        pre.prepend(note);
      }
    };

    if (!('IntersectionObserver' in window)) {
      for (const pre of targets) void render(pre);
      return;
    }
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          obs.unobserve(entry.target);
          void render(entry.target);
        }
      },
      { rootMargin: '200px' },
    );
    for (const pre of targets) io.observe(pre);
  }

  function openModal(svg) {
    const modal = document.querySelector('[data-mermaid-modal]');
    const canvas = modal.querySelector('[data-mermaid-canvas]');
    canvas.innerHTML = svg;
    canvas.style.transform = '';
    let scale = 1;
    let x = 0;
    let y = 0;
    const apply = () => {
      canvas.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
    };
    const zoomBy = (factor) => {
      scale = Math.min(6, Math.max(0.5, scale * factor));
      apply();
    };
    modal.querySelector('[data-mermaid-zoom-in]').onclick = () => zoomBy(1.25);
    modal.querySelector('[data-mermaid-zoom-out]').onclick = () => zoomBy(0.8);
    modal.querySelector('[data-mermaid-zoom-reset]').onclick = () => {
      scale = 1;
      x = 0;
      y = 0;
      apply();
    };
    modal.querySelector('[data-mermaid-close]').onclick = () => modal.close();

    // Single-pointer drag pans; two-pointer touch pinches to zoom.
    const pointers = new Map();
    let lastPinch = 0;
    const stage = modal.querySelector('[data-mermaid-stage]');
    stage.onpointerdown = (e) => {
      stage.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    };
    stage.onpointermove = (e) => {
      if (!pointers.has(e.pointerId)) return;
      const prev = pointers.get(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 1) {
        x += e.clientX - prev.x;
        y += e.clientY - prev.y;
        apply();
      } else if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (lastPinch > 0) zoomBy(dist / lastPinch);
        lastPinch = dist;
      }
    };
    const release = (e) => {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) lastPinch = 0;
    };
    stage.onpointerup = release;
    stage.onpointercancel = release;
    // Wheel zooms; page scroll still works outside the stage.
    stage.onwheel = (e) => {
      e.preventDefault();
      zoomBy(e.deltaY < 0 ? 1.1 : 0.9);
    };

    modal.showModal();
  }
</script>

<style>
  @layer starlight.components {
    .mermaid-figure {
      overflow-x: auto;
    }
    .mermaid-figure svg {
      max-width: 100%;
      height: auto;
    }
    .mermaid-open {
      margin-top: 0.5rem;
      min-height: 2.75rem;
      cursor: pointer;
    }
    .mermaid-warn {
      font-size: 0.9em;
      opacity: 0.85;
    }
    .mermaid-modal {
      width: min(96vw, 72rem);
      height: min(92dvh, 56rem);
      padding: 0;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.75rem;
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
    }
    .mermaid-modal::backdrop {
      background: rgb(0 0 0 / 0.6);
    }
    .mermaid-modal-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 0.9rem;
      border-bottom: 1px solid var(--sl-color-hairline);
    }
    .mermaid-modal-hint {
      font-size: 0.85em;
      opacity: 0.75;
    }
    .mermaid-modal-actions {
      display: flex;
      gap: 0.4rem;
    }
    .mermaid-modal-actions button {
      min-height: 2.75rem;
      min-width: 2.75rem;
      padding-inline: 0.7rem;
      cursor: pointer;
    }
    .mermaid-modal-stage {
      height: calc(100% - 3.5rem);
      overflow: hidden;
      touch-action: none;
      cursor: grab;
    }
    .mermaid-modal-canvas {
      width: 100%;
      height: 100%;
      transform-origin: center;
    }
    .mermaid-modal-canvas svg {
      width: 100%;
      height: 100%;
    }
  }
</style>
